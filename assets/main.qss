/* eDEX-UI Global Stylesheet */

/* Main window and base styling - eDEX-UI Tron Theme */
QMainWindow {
    background-color: #05080d;
    color: #aacfd1;
}

QWidget {
    background-color: #05080d;
    color: #aacfd1;
    font-family: "Rodchenko", sans-serif;
    font-size: 14px;
}

/* Tab Widget */
QTabWidget {
    background-color: transparent;
    border: none;
}

QTabWidget::pane {
    background-color: #05080d;
    border: 1px solid #262828;
    border-top: 2px solid #aacfd1;
}

QTabWidget::tab-bar {
    alignment: left;
}

/* QTabBar styling (custom painting overrides most of this) */
QTabBar {
    background-color: transparent;
}

QTabBar::tab {
    background-color: #262828;
    color: #666666;
    padding: 10px 30px;
    margin-right: 2px;
    font-size: 40px;
    font-weight: bold;
    text-transform: uppercase;
}

QTabBar::tab:selected {
    background-color: #aacfd1;
    color: #05080d;
}

QTabBar::tab:hover {
    color: #aacfd1;
}

/* Frames and Panels */
QFrame {
    background-color: #000000;
    border: 1px solid #262828;
}

/* Text Edit and Text Browser */
QTextEdit, QTextBrowser {
    background-color: #000000;
    color: #aacfd1;
    border: 1px solid #262828;
    border-radius: 4px;
    padding: 15px;
    font-size: 40px;
    selection-background-color: rgba(170, 207, 209, 0.3);
}

/* Labels */
QLabel {
    background-color: transparent;
    color: #aacfd1;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #000000;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #aacfd1;
    border-radius: 6px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(170, 207, 209, 0.8);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #000000;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #aacfd1;
    border-radius: 6px;
    min-width: 25px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(170, 207, 209, 0.8);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* Splitter */
QSplitter::handle {
    background-color: #aacfd1;
    width: 3px;
    height: 3px;
}

QSplitter::handle:hover {
    background-color: rgba(170, 207, 209, 0.8);
}

/* Status Bar */
QStatusBar {
    background-color: #000000;
    color: #666666;
    border-top: 1px solid #262828;
    font-size: 15px;
}

QStatusBar::item {
    border: none;
}

/* Push Buttons */
QPushButton {
    background-color: #151b23;
    color: #e8e8e8;
    border: 1px solid #1c2733;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 25px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: rgba(0, 217, 255, 0.1);
    border-color: #00d9ff;
}

QPushButton:pressed {
    background-color: rgba(0, 217, 255, 0.2);
}

/* Line Edit / Input */
QLineEdit {
    background-color: #0d1117;
    color: #e8e8e8;
    border: 1px solid #1c2733;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: rgba(0, 217, 255, 0.3);
}

QLineEdit:focus {
    border-color: #00d9ff;
}

/* Menu */
QMenu {
    background-color: #0d1117;
    color: #e8e8e8;
    border: 1px solid #1c2733;
}

QMenu::item:selected {
    background-color: rgba(0, 217, 255, 0.2);
}

/* Tooltip */
QToolTip {
    background-color: #0d1117;
    color: #e8e8e8;
    border: 1px solid #00d9ff;
    padding: 5px;
}
